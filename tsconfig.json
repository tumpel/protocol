{
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "paths": {
      "@tumpel/schemas": ["./build/schemas/schemas.ts"]
    }
  },
  "include": ["build/schemas/schemas.ts", "build/openapi/paths.ts", "build/openapi/frozen/*.ts", "build/api/*.ts"]
}
